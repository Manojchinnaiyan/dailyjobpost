---
export const prerender = false;
import Base from '../layouts/Base.astro';

const lastUpdated = '2026-06-11';
---

<Base
  title="Privacy Policy — dailyjobpost.online"
  description="Privacy Policy for dailyjobpost.online — how we collect, use, and protect your data."
>
  <div class="privacy-wrap">
    <div class="privacy-inner">

      <div class="privacy-header">
        <div class="privacy-ps1">
          <span class="ps1-prompt">user@dailyjobpost:~$</span>
          <span class="ps1-cmd"> cat privacy-policy.md</span>
        </div>
        <h1 class="privacy-title">Privacy Policy</h1>
        <p class="privacy-meta">Last updated: {lastUpdated} · dailyjobpost.online</p>
      </div>

      <div class="privacy-divider">// ═══════════════════════════════════════════ //</div>

      <div class="privacy-sections">

        <div class="privacy-section">
          <div class="privacy-section-title">▶ 1. OVERVIEW</div>
          <div class="privacy-section-body">
            <p>dailyjobpost.online ("we", "our", "the site") is committed to protecting your privacy. This policy explains what information we collect, how we use it, and your rights regarding that information.</p>
            <p>By using this site, you agree to the collection and use of information in accordance with this policy.</p>
          </div>
        </div>

        <div class="privacy-section">
          <div class="privacy-section-title">▶ 2. INFORMATION_WE_COLLECT</div>
          <div class="privacy-section-body">
            <p><strong>Authentication data:</strong> When you sign in using Google OAuth, we receive and store your email address to identify your session. We do not store your Google password or access token beyond what is required for authentication.</p>
            <p><strong>Session data:</strong> We store a session ID in a cookie (<code>djp_session</code>) to keep you logged in. This session is stored securely and expires after 7 days of inactivity.</p>
            <p><strong>Usage data:</strong> We may collect anonymised analytics data including pages visited and referring URLs. No personally identifiable information is collected for analytics purposes.</p>
            <p><strong>What we do NOT collect:</strong> We do not collect your name, phone number, address, payment information, or CV/resume data.</p>
          </div>
        </div>

        <div class="privacy-section">
          <div class="privacy-section-title">▶ 3. COOKIES</div>
          <div class="privacy-section-body">
            <p>We use the following cookies:</p>
            <ul class="privacy-list">
              <li><code>djp_session</code> — Session authentication cookie. Expires after 7 days. Required for sign-in functionality. HttpOnly, SameSite=Lax.</li>
              <li><strong>Google AdSense cookies</strong> — When advertisements are displayed on this site (served by Google AdSense), Google may use cookies to personalise ads based on your browsing history. These are third-party cookies governed by Google's Privacy Policy.</li>
              <li><strong>Analytics cookies</strong> — We may use privacy-friendly analytics tools that collect anonymised aggregate data. No cross-site tracking.</li>
            </ul>
            <p>You can disable cookies in your browser settings. Disabling the session cookie will prevent you from signing in.</p>
          </div>
        </div>

        <div class="privacy-section">
          <div class="privacy-section-title">▶ 4. THIRD_PARTY_SERVICES</div>
          <div class="privacy-section-body">
            <ul class="privacy-list">
              <li><strong>Google OAuth 2.0</strong> — Used for sign-in. When you authenticate, Google shares your email address with us. Google's use of this data is governed by Google's Privacy Policy at <a href="https://policies.google.com/privacy" class="privacy-link" target="_blank" rel="noopener">policies.google.com/privacy</a>.</li>
              <li><strong>Google AdSense</strong> — We use Google AdSense to display advertisements. Third-party vendors, including Google, use cookies to serve ads based on your prior visits to this website and other websites. Google's use of advertising cookies enables it and its partners to serve ads to you based on your visit to this site and/or other sites on the internet. You may opt out of personalised advertising by visiting <a href="https://www.google.com/settings/ads" class="privacy-link" target="_blank" rel="noopener">Google Ads Settings</a>, or opt out of third-party vendor cookies at <a href="https://www.aboutads.info/choices/" class="privacy-link" target="_blank" rel="noopener">aboutads.info/choices</a>.</li>
              <li><strong>Hosting &amp; delivery</strong> — Our hosting and content-delivery providers process basic request logs (such as IP address and timestamp) for performance, reliability, and security purposes.</li>
            </ul>
          </div>
        </div>

        <div class="privacy-section">
          <div class="privacy-section-title">▶ 5. HOW_WE_USE_YOUR_DATA</div>
          <div class="privacy-section-body">
            <ul class="privacy-list">
              <li>To authenticate you and maintain your session</li>
              <li>To personalise your experience (saved preferences, theme)</li>
              <li>To improve the site through anonymised analytics</li>
              <li>We do not sell, rent, or trade your personal data to any third party</li>
              <li>We do not use your data for marketing without explicit consent</li>
            </ul>
          </div>
        </div>

        <div class="privacy-section">
          <div class="privacy-section-title">▶ 6. DATA_RETENTION</div>
          <div class="privacy-section-body">
            <p>Session records are automatically deleted after 7 days of inactivity. You can sign out at any time to immediately invalidate your session. To request deletion of your email from our database, contact us at the address below.</p>
          </div>
        </div>

        <div class="privacy-section">
          <div class="privacy-section-title">▶ 7. YOUR_RIGHTS</div>
          <div class="privacy-section-body">
            <p>Depending on your location, you may have the right to:</p>
            <ul class="privacy-list">
              <li>Access the personal data we hold about you</li>
              <li>Request correction of inaccurate data</li>
              <li>Request deletion of your data (right to erasure)</li>
              <li>Object to processing of your data</li>
              <li>Data portability</li>
            </ul>
            <p>To exercise these rights, email us at <a href="mailto:contact@dailyjobpost.online" class="privacy-link">contact@dailyjobpost.online</a>. We will respond within 30 days.</p>
          </div>
        </div>

        <div class="privacy-section">
          <div class="privacy-section-title">▶ 8. SECURITY</div>
          <div class="privacy-section-body">
            <p>We use HTTPS (TLS) for all data in transit. Session tokens are cryptographically random and stored with HttpOnly, Secure, and SameSite=Lax attributes. Our database access is restricted to our application's server functions only.</p>
          </div>
        </div>

        <div class="privacy-section">
          <div class="privacy-section-title">▶ 9. CHILDREN</div>
          <div class="privacy-section-body">
            <p>This site is not directed to children under the age of 13. We do not knowingly collect personal data from children. If you believe a child has provided us with personal data, please contact us immediately.</p>
          </div>
        </div>

        <div class="privacy-section">
          <div class="privacy-section-title">▶ 10. CHANGES_TO_THIS_POLICY</div>
          <div class="privacy-section-body">
            <p>We may update this privacy policy from time to time. The "Last updated" date at the top of this page will reflect the most recent revision. Continued use of the site after changes constitutes acceptance of the updated policy.</p>
          </div>
        </div>

        <div class="privacy-section">
          <div class="privacy-section-title">▶ 11. CONTACT</div>
          <div class="privacy-section-body">
            <p>For privacy-related questions, data requests, or concerns:</p>
            <p><strong>Email:</strong> <a href="mailto:contact@dailyjobpost.online" class="privacy-link">contact@dailyjobpost.online</a></p>
            <p><strong>Site:</strong> dailyjobpost.online</p>
          </div>
        </div>

      </div>

      <div class="privacy-divider">// ═══════════════════════════════════════════ //</div>

      <div class="privacy-footer-links">
        <a href="/">← Back to Jobs</a>
        <a href="/about">About</a>
      </div>

    </div>
  </div>
</Base>

<style>
.privacy-wrap {
  max-width: 1280px;
  margin: 0 auto;
  padding: 48px 24px 80px;
}

.privacy-inner {
  max-width: 720px;
  margin: 0 auto;
}

.privacy-header { margin-bottom: 28px; }

.privacy-ps1 {
  font-size: 12px;
  color: var(--text-3);
  margin-bottom: 18px;
}
.ps1-prompt { color: var(--amber); }
.ps1-cmd { color: var(--text-2); }

.privacy-title {
  font-size: 24px;
  font-weight: 700;
  color: var(--green);
  text-shadow: var(--glow);
  letter-spacing: 1px;
  margin-bottom: 8px;
}

.privacy-meta {
  font-size: 11px;
  color: var(--text-3);
  letter-spacing: 0.5px;
}

.privacy-divider {
  color: var(--text-3);
  font-size: 12px;
  letter-spacing: 1px;
  margin: 24px 0;
}

.privacy-sections {
  display: flex;
  flex-direction: column;
}

.privacy-section {
  border: 1px solid var(--border);
  border-bottom: none;
  background: var(--surface);
}
.privacy-section:last-child { border-bottom: 1px solid var(--border); }

.privacy-section-title {
  background: var(--border);
  color: var(--text-2);
  padding: 6px 14px;
  font-size: 10px;
  letter-spacing: 2px;
  font-weight: 700;
}

.privacy-section-body {
  padding: 16px 18px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  color: var(--text-2);
  font-size: 12px;
  line-height: 1.9;
}

.privacy-section-body strong { color: var(--text); }

.privacy-section-body code {
  background: var(--surface2);
  border: 1px solid var(--border);
  padding: 1px 6px;
  font-family: var(--font);
  font-size: 11px;
  color: var(--amber);
}

.privacy-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding-left: 12px;
}

.privacy-list li {
  padding-left: 12px;
  border-left: 2px solid var(--border);
  font-size: 12px;
  color: var(--text-2);
  line-height: 1.8;
}

.privacy-link {
  color: var(--green);
  text-decoration: none;
  border-bottom: 1px solid rgba(51,255,0,0.3);
}
.privacy-link:hover { border-bottom-color: var(--green); }

.privacy-footer-links {
  display: flex;
  gap: 24px;
  font-size: 12px;
  margin-top: 24px;
}
.privacy-footer-links a {
  color: var(--text-3);
  text-decoration: none;
  border-bottom: 1px solid var(--border);
  padding-bottom: 2px;
  transition: color 0.1s, border-color 0.1s;
}
.privacy-footer-links a:hover { color: var(--green); border-color: var(--green); }
</style>
