---
export const prerender = false;
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import JobResults from '../components/JobResults.astro';
import { queryJobs, filtersFromUrl } from '../lib/jobquery';

const { env } = Astro.locals.runtime;
const filters = filtersFromUrl(Astro.url);
filters.type = 'internship';
const { jobs, total, page, pages } = await queryJobs(env.DB, filters);

const makeHref = (n: number) => {
  const p = new URLSearchParams();
  if (filters.q) p.set('q', filters.q);
  if (n > 1) p.set('page', String(n));
  const s = p.toString();
  return '/internships' + (s ? `?${s}` : '');
};
---

<Base
  title="Internships — Start Your Career — dailyjobpost.online"
  description={`${total} internships across every industry. Kickstart your career. Updated daily.`}
>
  <div class="page-header">
    <div class="page-header-inner">
      <a href="/" class="back-link">← ALL_JOBS</a>
      <h1 class="page-header-title">▶ INTERNSHIPS</h1>
      <p class="page-header-sub">{total.toLocaleString()} internship{total !== 1 ? 's' : ''} · start your career, worldwide</p>
      <form class="page-search" method="get" action="/internships">
        <span class="page-search-prefix">$</span>
        <input class="page-search-input" type="text" name="q" value={filters.q ?? ''} placeholder="search internships..." spellcheck="false" />
        <button type="submit" class="page-search-btn">SEARCH →</button>
      </form>
    </div>
  </div>

  <div class="jobs-section">
    <JobResults jobs={jobs} total={total} page={page} pages={pages} query={filters.q} makeHref={makeHref} />
  </div>

  <Footer />
</Base>
