---
export const prerender = false;
import Base from '../layouts/Base.astro';
import JobList from '../components/JobList';
import type { Job } from '../components/JobList';
import { rowToJob, type JobRow } from '../lib/db';

const { env } = Astro.locals.runtime;
const result = await env.DB.prepare('SELECT * FROM jobs ORDER BY posted DESC, created_at DESC').all<JobRow>();
const jobs: Job[] = (result.results ?? []).map(rowToJob);
const internCount = jobs.filter(j => j.type === 'internship').length;
---

<Base
  title="Engineering Internships — dailyjobpost.online"
  description={`${internCount} engineering internship${internCount !== 1 ? 's' : ''}. Start your career. Find internship roles on dailyjobpost.online.`}
>

  <!-- Page header -->
  <div class="page-header">
    <div class="page-header-inner">
      <a href="/" class="back-link">← ALL_JOBS</a>
      <h1 class="page-header-title">▶ INTERNSHIPS</h1>
      <p class="page-header-sub">{internCount} engineering internship{internCount !== 1 ? 's' : ''} · start your career</p>
    </div>
  </div>

  <!-- Job listing -->
  <div class="jobs-section">
    <JobList jobs={jobs} client:load withSearch initialTypeFilter="internship" />
  </div>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-logo">
        <span class="nav-logo-icon">$_</span>
        <span class="nav-logo-text">DAILYJOBPOST.ONLINE</span>
      </div>
      <div class="footer-links">
        <a href="/">Jobs</a>
        <a href="/">About</a>
        <a href="/">Privacy</a>
      </div>
      <div class="footer-status">
        <span style="color: var(--green);">[OK]</span> ALL SYSTEMS OPERATIONAL
      </div>
    </div>
    <div class="footer-copy">
      data is static · rebuilt on every github push · no trackers · no cookies · dailyjobpost.online v2.1
    </div>
  </footer>

</Base>
