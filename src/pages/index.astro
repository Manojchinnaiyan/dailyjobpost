---
export const prerender = false;
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import JobResults from '../components/JobResults.astro';
import { queryJobs, filtersFromUrl, pageHref } from '../lib/jobquery';
import { getHomeStats, CATEGORIES, COUNTRY_META } from '../lib/homestats';
import { CATEGORY_SLUG, COUNTRY_SLUG } from '../lib/landing';
import { AD_CLIENT, AD_SLOTS } from '../lib/ads';

const { env } = Astro.locals.runtime;
const filters = filtersFromUrl(Astro.url);

// Page of results (filtered + paginated, no body shipped to client)
const { jobs, total, page, pages } = await queryJobs(env.DB, filters);

// Browse counts — cached in-memory (recomputed at most once per 10 min)
const { grandTotal, remoteCount, newThisWeek, categoryStats, countryStats } = await getHomeStats(env.DB);

const POSTED_LABELS: Record<string, string> = { '1': 'past 24 hours', '3': 'past 3 days', '7': 'past week', '14': 'past 2 weeks', '30': 'past month' };
const hasFilter = !!(filters.q || filters.type || filters.category || filters.country || filters.posted);
const activeLabel = filters.q ? `"${filters.q}"` : filters.category || filters.country || (filters.type ? `--${filters.type}` : '') || (filters.posted ? POSTED_LABELS[filters.posted] : '');

const jsonLd = JSON.stringify({
  "@context": "https://schema.org", "@type": "WebSite",
  "name": "dailyjobpost.online", "url": "https://dailyjobpost.online",
  "description": "Find jobs worldwide across every industry. New listings posted daily.",
  "potentialAction": { "@type": "SearchAction", "target": { "@type": "EntryPoint", "urlTemplate": "https://dailyjobpost.online/?q={search_term_string}" }, "query-input": "required name=search_term_string" }
});

/* ── Dynamic SEO per active facet ── */
let seoTitle = 'dailyjobpost.online — Find Jobs Worldwide, Updated Daily';
let seoDesc  = 'Search thousands of jobs across every industry and country. Software, marketing, finance, design, healthcare and more. New roles posted daily.';
if (filters.category) {
  seoTitle = `${filters.category} Jobs — ${total.toLocaleString()} Open Roles | dailyjobpost.online`;
  seoDesc  = `Browse ${total.toLocaleString()} ${filters.category} jobs worldwide. Apply to roles updated daily on dailyjobpost.online.`;
} else if (filters.country) {
  seoTitle = `Jobs in ${filters.country} — ${total.toLocaleString()} Openings | dailyjobpost.online`;
  seoDesc  = `Find ${total.toLocaleString()} jobs in ${filters.country} across every industry. Updated daily on dailyjobpost.online.`;
} else if (filters.type) {
  seoTitle = `${filters.type.replace('-', ' ')} Jobs — dailyjobpost.online`;
  seoDesc  = `Browse ${total.toLocaleString()} ${filters.type.replace('-', ' ')} jobs worldwide, updated daily.`;
} else if (filters.q) {
  seoTitle = `"${filters.q}" Jobs — dailyjobpost.online`;
  seoDesc  = `${total.toLocaleString()} jobs matching "${filters.q}". Updated daily on dailyjobpost.online.`;
}

/* Canonical: point facet views at their clean landing-page URL so all the
   ?category= / ?country= variants consolidate into one indexable page.
   noindex raw free-text searches. */
let seoCanonical = 'https://dailyjobpost.online/';
if (filters.category && CATEGORY_SLUG[filters.category]) {
  seoCanonical = `https://dailyjobpost.online/category/${CATEGORY_SLUG[filters.category]}`;
} else if (filters.country === 'Remote') {
  seoCanonical = 'https://dailyjobpost.online/remote';
} else if (filters.country && COUNTRY_SLUG[filters.country]) {
  seoCanonical = `https://dailyjobpost.online/jobs-in/${COUNTRY_SLUG[filters.country]}`;
} else if (filters.type === 'internship') {
  seoCanonical = 'https://dailyjobpost.online/internships';
} else if (filters.type === 'remote') {
  seoCanonical = 'https://dailyjobpost.online/remote';
}
const seoNoindex = !!filters.q;
---

<Base title={seoTitle} description={seoDesc} canonical={seoCanonical} noindex={seoNoindex}>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLd} />

  <!-- ── Hero ──────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-cmd-row">
        <span class="hero-ps1">user@dailyjobpost:~$</span>
        <span class="hero-cmd-text"> find /jobs --worldwide --sort=latest</span>
        <span class="hero-blink">▋</span>
      </div>

      <h1 class="hero-headline">Find your next job, <span class="hero-headline-accent">worldwide</span>.</h1>
      <p class="hero-subhead">{grandTotal.toLocaleString()} open roles across every industry &amp; country — updated daily.</p>

      <div class="hero-counts">
        <div class="hero-count-item"><span class="hero-count-n">{grandTotal.toLocaleString()}</span><span class="hero-count-l">OPEN JOBS</span></div>
        <span class="hero-count-div">·</span>
        <div class="hero-count-item"><span class="hero-count-n">{remoteCount.toLocaleString()}</span><span class="hero-count-l">REMOTE</span></div>
        <span class="hero-count-div">·</span>
        <div class="hero-count-item"><span class="hero-count-n">{newThisWeek.toLocaleString()}</span><span class="hero-count-l">NEW THIS WEEK</span></div>
      </div>

      <form class="hero-search" method="get" action="/">
        <span class="hero-search-prefix">$</span>
        <input class="hero-search-input" type="text" name="q" value={filters.q ?? ''} placeholder="job title, skill, company or country..." spellcheck="false" />
        <button type="submit" class="hero-search-btn">SEARCH →</button>
      </form>

      <div class="hero-chips">
        <span class="hero-chips-label">popular:</span>
        <a href="/remote" class="hero-chip">remote</a>
        <a href="/category/marketing" class="hero-chip">marketing</a>
        <a href="/category/software-it" class="hero-chip">software</a>
        <a href="/category/finance" class="hero-chip">finance</a>
        <a href="/category/design" class="hero-chip">design</a>
        <a href="/internships" class="hero-chip">internships</a>
      </div>
    </div>
  </section>

  <!-- ── Browse by category ────────────────────────────── -->
  {!hasFilter && categoryStats.length > 0 && (
    <section class="cat-section">
      <div class="cat-inner">
        <div class="section-head">
          <span class="section-head-bar">▶</span>
          <span class="section-head-title">BROWSE BY CATEGORY</span>
          <span class="section-head-sub">// {grandTotal.toLocaleString()} jobs across {categoryStats.length} industries</span>
        </div>
        <div class="cat-grid">
          {categoryStats.map(c => (
            <a href={`/category/${CATEGORY_SLUG[c.name]}`} class="cat-card">
              <span class="cat-card-marker">&gt;</span>
              <span class="cat-card-name">{c.name}</span>
              <span class="cat-card-count">{c.count} {c.count === 1 ? 'job' : 'jobs'}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── Countries strip ───────────────────────────────── -->
  {!hasFilter && countryStats.length > 0 && (
    <section class="countries-strip">
      <div class="countries-inner">
        <div class="countries-label">$ browse --by-country</div>
        <div class="countries-scroll">
          {countryStats.map(c => (
            <a href={c.name === 'Remote' ? '/remote' : `/jobs-in/${COUNTRY_SLUG[c.name]}`} class="country-chip">
              <span class="country-flag">{c.flag}</span>
              <span class="country-name">{c.name}</span>
              <span class="country-count">{c.count}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── Ad banner ─────────────────────────────────────── -->
  {AD_SLOTS.banner && (
    <div class="ad-slot-outer">
      <div class="ad-slot-inner">
        <div class="ad-label">ADVERTISEMENT</div>
        <ins class="adsbygoogle ad-banner" style="display:block" data-ad-client={AD_CLIENT} data-ad-slot={AD_SLOTS.banner} data-ad-format="horizontal" data-full-width-responsive="true"></ins>
        <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
      </div>
    </div>
  )}

  <!-- ── Listings ──────────────────────────────────────── -->
  <div class="jobs-section">
    <div class="section-head section-head--inline">
      <span class="section-head-bar">▶</span>
      <span class="section-head-title">{hasFilter ? 'SEARCH RESULTS' : 'LATEST JOBS'}</span>
      <span class="section-head-sub">// {hasFilter ? 'filtered' : 'sorted by most recent'}</span>
    </div>

    <form class="filter-bar" method="get" action="/">
      <div class="filter-field filter-field--q">
        <span class="filter-prefix">$</span>
        <input class="filter-q" type="text" name="q" value={filters.q ?? ''} placeholder="search title, company, skill..." spellcheck="false" />
      </div>
      <select class="filter-sel" name="type" aria-label="Job type">
        <option value="">type: all</option>
        {[['full-time','Full-time'],['part-time','Part-time'],['contract','Contract'],['internship','Internship'],['remote','Remote']].map(([v,l]) => (
          <option value={v} selected={filters.type === v}>{l}</option>
        ))}
      </select>
      <select class="filter-sel" name="category" aria-label="Category">
        <option value="">category: all</option>
        {CATEGORIES.map(c => <option value={c.name} selected={filters.category === c.name}>{c.name}</option>)}
      </select>
      <select class="filter-sel" name="country" aria-label="Country">
        <option value="">country: all</option>
        {COUNTRY_META.map(c => <option value={c.name} selected={filters.country === c.name}>{c.name}</option>)}
      </select>
      <select class="filter-sel" name="posted" aria-label="Date posted">
        <option value="">posted: any</option>
        {[['1','past 24 hours'],['3','past 3 days'],['7','past week'],['14','past 2 weeks'],['30','past month']].map(([v,l]) => (
          <option value={v} selected={filters.posted === v}>{l}</option>
        ))}
      </select>
      <button type="submit" class="filter-go">FILTER →</button>
    </form>

    {hasFilter && (
      <div class="active-filter-bar">
        <span class="active-filter-tag">{activeLabel}</span>
        <a class="active-filter-clear" href="/">✕ clear filters</a>
      </div>
    )}

    <JobResults jobs={jobs} total={total} page={page} pages={pages} query={filters.q} makeHref={(n) => pageHref(filters, n)} />
  </div>

  <!-- ── Subscribe ─────────────────────────────────────── -->
  <section class="alert-section">
    <div class="alert-inner">
      <div class="alert-body">
        <div class="alert-copy">
          <div class="alert-title">Get new jobs in your inbox</div>
          <div class="alert-sub">A daily digest of the freshest roles. No spam. Unsubscribe anytime.</div>
        </div>
        <form class="alert-form" onsubmit="return false" aria-label="Subscribe to job alerts">
          <span class="alert-prompt">$</span>
          <input type="email" class="alert-input" placeholder="your@email.com" autocomplete="email" aria-label="Email address" />
          <button type="submit" class="btn btn-primary" style="padding:12px 16px;border:none;flex-shrink:0">[ SUBSCRIBE ]</button>
        </form>
      </div>
    </div>
  </section>

  <!-- ── Footer ad ─────────────────────────────────────── -->
  {AD_SLOTS.footer && (
    <div class="ad-slot-outer">
      <div class="ad-slot-inner">
        <div class="ad-label">ADVERTISEMENT</div>
        <ins class="adsbygoogle ad-banner" style="display:block" data-ad-client={AD_CLIENT} data-ad-slot={AD_SLOTS.footer} data-ad-format="horizontal" data-full-width-responsive="true"></ins>
        <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
      </div>
    </div>
  )}

  <Footer />
</Base>
