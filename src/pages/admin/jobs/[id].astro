---
export const prerender = false;
import { SESSION_COOKIE, getSession } from '../../../lib/auth';
import { rowToJob, type JobRow } from '../../../lib/db';

const { env } = Astro.locals.runtime;
const sid = Astro.cookies.get(SESSION_COOKIE)?.value;
const session = await getSession(env.DB, sid);
if (!session || session.role !== 'admin') return Astro.redirect('/admin/login');

const { id } = Astro.params;
const row = await env.DB.prepare('SELECT * FROM jobs WHERE id = ?').bind(id).first<JobRow>();
if (!row) return Astro.redirect('/admin/dashboard');

const job = rowToJob(row);
const error = Astro.url.searchParams.get('error');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Job #{job.id} — Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; border-radius: 0; }
    :root {
      --bg: #f1f5f9; --white: #fff; --border: #e2e8f0;
      --text: #0f172a; --text-2: #475569; --text-3: #94a3b8;
      --green: #16a34a; --red: #dc2626; --red-l: #fef2f2;
      --font: 'JetBrains Mono', monospace;
    }
    body { background: var(--bg); color: var(--text); font-family: var(--font); font-size: 13px; line-height: 1.6; min-height: 100vh; }
    a { color: inherit; text-decoration: none; }

    .ah { background: var(--white); border-bottom: 2px solid var(--green); position: sticky; top: 0; z-index: 100; }
    .ah-inner { max-width: 1280px; margin: 0 auto; padding: 0 24px; height: 52px; display: flex; align-items: center; gap: 16px; }
    .ah-brand { font-size: 12px; font-weight: 700; color: var(--green); letter-spacing: 2px; }
    .ah-back { font-size: 11px; color: var(--text-3); padding: 16px 10px; border-bottom: 2px solid transparent; margin-bottom: -2px; }
    .ah-back:hover { color: var(--green); border-color: var(--green); }
    .ah-right { margin-left: auto; font-size: 10px; color: var(--text-3); }

    .btn { font-family: var(--font); font-size: 11px; font-weight: 700; letter-spacing: 0.5px; padding: 8px 18px; border: 1px solid transparent; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 5px; transition: all 0.1s; }
    .btn-primary { background: var(--green); color: #fff; border-color: var(--green); }
    .btn-primary:hover { background: #15803d; }
    .btn-ghost { background: transparent; color: var(--text-2); border-color: var(--border); }
    .btn-ghost:hover { background: var(--bg); }
    .btn-danger { background: transparent; color: var(--red); border-color: var(--border); }
    .btn-danger:hover { background: var(--red-l); border-color: var(--red); }

    .awrap { max-width: 860px; margin: 0 auto; padding: 32px 24px 60px; }
    .aph { margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
    .aph-title { font-size: 16px; font-weight: 700; margin-bottom: 3px; }
    .aph-sub { font-size: 11px; color: var(--text-3); }

    .aerror { color: var(--red); font-size: 11px; background: var(--red-l); border: 1px solid #fca5a5; padding: 10px 14px; margin-bottom: 20px; }

    .agrid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    @media (max-width: 640px) { .agrid { grid-template-columns: 1fr; } }
    .afield { display: flex; flex-direction: column; gap: 5px; }
    .afield.full { grid-column: 1 / -1; }
    .alabel { font-size: 9px; letter-spacing: 2px; color: var(--text-3); font-weight: 700; }
    .ainput, .aselect, .atextarea {
      background: var(--white); border: 1px solid var(--border); color: var(--text);
      font-family: var(--font); font-size: 12px; padding: 9px 12px; width: 100%;
      outline: none; transition: border-color 0.15s;
    }
    .ainput:focus, .aselect:focus, .atextarea:focus { border-color: var(--green); }
    .atextarea { resize: vertical; min-height: 220px; line-height: 1.7; }
    .acheck-row { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--text-2); }
    .acheck-row input[type="checkbox"] { accent-color: var(--green); width: 14px; height: 14px; }
    .ahint { font-size: 10px; color: var(--text-3); }
    .aform-actions { display: flex; gap: 10px; align-items: center; margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--border); flex-wrap: wrap; }
    .del-zone { margin-left: auto; }
  </style>
</head>
<body>
  <header class="ah">
    <div class="ah-inner">
      <span class="ah-brand">$_ ADMIN</span>
      <a href="/admin/dashboard" class="ah-back">← Dashboard</a>
      <span class="ah-right">{session.email}</span>
    </div>
  </header>

  <main class="awrap">
    <div class="aph">
      <div>
        <div class="aph-title">Edit Job #{job.id}</div>
        <div class="aph-sub">slug: {job.slug}</div>
      </div>
      <a href={`/jobs/${job.slug}`} target="_blank" class="btn btn-ghost" style="font-size:10px">↗ Preview</a>
    </div>

    {error && <div class="aerror">Title, company, and location are required.</div>}

    <form method="POST" action={`/api/jobs/${job.id}`}>
      <div class="agrid">

        <div class="afield">
          <label class="alabel">JOB TITLE *</label>
          <input class="ainput" type="text" name="title" value={job.title} required />
        </div>

        <div class="afield">
          <label class="alabel">COMPANY *</label>
          <input class="ainput" type="text" name="company" value={job.company} required />
        </div>

        <div class="afield">
          <label class="alabel">LOCATION *</label>
          <input class="ainput" type="text" name="location" value={job.location} required />
        </div>

        <div class="afield">
          <label class="alabel">TYPE</label>
          <select class="aselect" name="type">
            {['full-time','part-time','contract','remote','internship'].map(t => (
              <option value={t} selected={job.type === t}>{t}</option>
            ))}
          </select>
        </div>

        <div class="afield">
          <label class="alabel">SALARY / COMP</label>
          <input class="ainput" type="text" name="salary" value={job.salary} />
        </div>

        <div class="afield">
          <label class="alabel">EXPERIENCE</label>
          <input class="ainput" type="text" name="experience" value={job.experience} />
        </div>

        <div class="afield">
          <label class="alabel">CATEGORY</label>
          <select class="aselect" name="category">
            {['Software / IT','Marketing','Sales','Finance','Design','Healthcare','Education','Data & Analytics','Operations','Human Resources','Customer Support','Engineering','Product','Legal','Writing & Content'].map(c => (
              <option value={c} selected={job.category === c}>{c}</option>
            ))}
          </select>
        </div>

        <div class="afield">
          <label class="alabel">DATE POSTED</label>
          <input class="ainput" type="date" name="posted" value={job.posted} />
        </div>

        <div class="afield full">
          <label class="alabel">APPLY URL</label>
          <input class="ainput" type="url" name="apply_url" value={job.applyUrl} />
        </div>

        <div class="afield full">
          <label class="alabel">TAGS (comma-separated)</label>
          <input class="ainput" type="text" name="tags" value={job.tags.join(', ')} />
          <span class="ahint">These appear as skill tags on the job listing.</span>
        </div>

        <div class="afield full" style="display:flex;gap:24px;flex-wrap:wrap">
          <label class="acheck-row">
            <input type="checkbox" name="remote" checked={job.remote} />
            Remote OK
          </label>
        </div>

        <div class="afield full">
          <label class="alabel">JOB DESCRIPTION (Markdown supported)</label>
          <textarea class="atextarea" name="body">{job.body}</textarea>
          <span class="ahint">Supports **bold**, ## headings, - bullet lists, `code`.</span>
        </div>

      </div>

      <div class="aform-actions">
        <button type="submit" class="btn btn-primary">Save Changes →</button>
        <a href="/admin/dashboard" class="btn btn-ghost">Cancel</a>
        <div class="del-zone">
          <form method="POST" action={`/api/jobs/${job.id}`} onsubmit="return confirm('Permanently delete this job?')" style="display:inline">
            <input type="hidden" name="_method" value="DELETE" />
            <button type="submit" class="btn btn-danger">Delete Job</button>
          </form>
        </div>
      </div>
    </form>
  </main>
</body>
</html>
