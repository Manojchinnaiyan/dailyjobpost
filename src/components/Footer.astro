---
const year = 2026;
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-col footer-col--brand">
      <div class="footer-logo">
        <span class="nav-logo-icon">$_</span>
        <span class="nav-logo-text" style="font-size:13px">DAILYJOBPOST</span>
      </div>
      <p class="footer-tagline">Fresh jobs every day, worldwide. Search thousands of roles across every industry and country.</p>
    </div>

    <div class="footer-col">
      <div class="footer-col-title">BROWSE</div>
      <a href="/">All Jobs</a>
      <a href="/remote">Remote Jobs</a>
      <a href="/internships">Internships</a>
      <a href="/guides">Career Guides</a>
    </div>

    <div class="footer-col">
      <div class="footer-col-title">COMPANY</div>
      <a href="/about">About</a>
      <a href="/privacy">Privacy Policy</a>
      <a href="/contact">Contact</a>
    </div>

    <div class="footer-col">
      <div class="footer-col-title">STATUS</div>
      <div class="footer-status-line">
        <span style="color: var(--green);">[OK]</span> All systems operational
      </div>
      <div class="footer-status-line footer-status-line--dim">Updated daily · global coverage</div>
    </div>
  </div>

  <div class="footer-bottom">
    <span>© {year} dailyjobpost.online — All rights reserved.</span>
    <span class="footer-bottom-links">
      <a href="/privacy">Privacy</a>
      <span class="footer-dot">·</span>
      <a href="/about">About</a>
    </span>
  </div>
</footer>
